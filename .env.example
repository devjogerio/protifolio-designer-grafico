# Configurações do EmailJS
# Renomeie este arquivo para .env e preencha os valores
# Obtenha estas credenciais no painel do EmailJS: https://dashboard.emailjs.com/admin

# ID do Serviço de Email (ex: service_xxxxxx)
# Conectado ao Outlook, Gmail, etc.
VITE_EMAILJS_SERVICE_ID=service_v3v44yi

# ID do Template de Email (ex: template_xxxxxx)
# Modelo criado na aba "Email Templates"
VITE_EMAILJS_TEMPLATE_ID=template_5eo0cko

# Chave Pública da API (ex: user_xxxxxx ou public_key_xxxxxx)
# Encontrada em "Account" > "API Keys"
VITE_EMAILJS_PUBLIC_KEY=public_key_xxxxxx
